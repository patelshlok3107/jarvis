# Frontend (Vercel) - only NEXT_PUBLIC_ vars are exposed to browser
NEXT_PUBLIC_API_URL=https://your-jarvis-backend.onrender.com
NEXT_PUBLIC_ANDROID_APK_URL=https://github.com/patelshlok3107/jarvis/releases/latest/download/JARVIS-v1.1.5.apk

# Backend (Render)
# CORS - set to your Vercel URL(s), comma-separated. Example: https://jarvis-xxxxx.vercel.app
ALLOWED_ORIGIN=https://your-jarvis-frontend.vercel.app
# AI - optional. If empty, backend uses offline template replies (no key needed)
AI_API_KEY=
AI_PROVIDER=openai
AI_ENDPOINT=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini
# Render injects PORT automatically; do not set locally unless needed
PORT=10000
